.container
  width 100%
  max-width 500px
  margin 0 auto
  padding 0 24px

.receiveArea
  margin 20px 0

.codeInput
  width 100%
  padding 16px
  font-size 22px
  text-align center
  letter-spacing 8px
  border 2px solid #d1d5db
  border-radius 14px
  outline none
  font-weight 600
  background #fafafa
  caret-color #16a34a
  &:focus
    border-color #16a34a
    background white

.btnRecv
  display block
  width 100%
  padding 16px
  font-size 16px
  font-weight 600
  border none
  border-radius 14px
  cursor pointer
  background #16a34a
  color white
  transition background 0.2s
  margin-top 12px
  &:hover
    background #15803d
  &:disabled
    background #86efac
    cursor not-allowed

.fileInfo
  background #f0fdf4
  border 1px solid #bbf7d0
  border-radius 12px
  padding 14px
  margin 12px 0
  font-size 13px

.fileInfoName
  font-weight 600
  color #166534

.fileInfoSize
  color #15803d
  margin-top 2px

.fileSummary
  text-align center
  color #6b7280
  font-size 13px
  margin 8px 0

.fileRow
  display flex
  justify-content space-between
  align-items center
  padding 8px 0
  border-bottom 1px solid #f3f4f6
  font-size 13px
  &:last-child
    border-bottom none

.fileRowName
  color #374151
  font-weight 500
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  margin-right 8px

.fileRowPct
  color #2563eb
  font-weight 600

.fileRowDone
  color #16a34a

.btnDownload
  display block
  width 100%
  padding 16px
  font-size 16px
  font-weight 600
  border none
  border-radius 14px
  cursor pointer
  background #2563eb
  color white
  transition background 0.2s
  margin-top 12px
  &:hover
    background #1d4ed8
  &:disabled
    background #93c5fd
    cursor not-allowed

.status
  margin 10px 0
  font-size 13px
  color #6b7280
  text-align center
  &.error
    color #dc2626
  &.success
    color #16a34a
    font-weight 600
    font-size 15px

.progressContainer
  margin 16px 0

.progressBarBg
  width 100%
  height 6px
  background #e5e7eb
  border-radius 3px
  overflow hidden

.progressBarFill
  height 100%
  width 0%
  background #2563eb
  border-radius 3px
  transition width 0.3s ease

.progressText
  margin-top 6px
  font-size 12px
  color #2563eb
  font-weight 500
  text-align center

.speedText
  font-size 11px
  color #6b7280
  text-align center
  margin-top 2px

.btnBack
  display flex
  align-items center
  justify-content center
  margin 20px auto 0
  padding 0
  font-size 20px
  background #f3f4f6
  border 1px solid #d1d5db
  border-radius 50%
  cursor pointer
  color #374151
  width 48px
  height 48px
  line-height 1
  transition all 0.2s
  outline none
  &:hover
    background #e5e7eb
    transform scale(1.05)
