.container
  width 100%
  max-width 500px
  margin 0 auto
  padding 0 24px

.dropZone
  border 2px dashed #d1d5db
  border-radius 16px
  padding 48px 20px
  cursor pointer
  transition all 0.2s
  text-align center
  background #fafafa
  outline none
  &.dragActive
    border-color #2563eb
    background #eff6ff

.dropIcon
  font-size 40px
  margin-bottom 8px

.dropText
  color #6b7280
  font-size 14px

.dropHint
  font-size 11px
  color #9ca3af
  margin-top 4px

.fileInfo
  background #f0fdf4
  border 1px solid #bbf7d0
  border-radius 12px
  padding 14px
  margin 12px 0
  font-size 13px
  word-break break-all
  display flex
  justify-content space-between
  align-items center

.fileName
  font-weight 600
  color #166534

.fileSize
  color #15803d
  font-size 12px
  margin-top 2px

.fileRemove
  cursor pointer
  color #dc2626
  font-size 18px
  padding 4px
  line-height 1

.fileSummary
  text-align center
  color #6b7280
  font-size 13px
  margin 8px 0

.btnSelectDone
  display block
  width 100%
  padding 16px
  font-size 16px
  font-weight 600
  border none
  border-radius 14px
  cursor pointer
  background #2563eb
  color white
  transition background 0.2s
  margin-top 12px
  &:hover
    background #1d4ed8
  &:disabled
    background #93c5fd
    cursor not-allowed

.codeDisplay
  text-align center
  margin 20px 0

.codeNumber
  font-size 42px
  font-weight 800
  letter-spacing 6px
  color #2563eb
  background #eff6ff
  border-radius 14px
  padding 14px 20px
  display inline-block

@media (min-width: 768px)
  .codeNumber
    font-size 52px

.codeHint
  color #6b7280
  font-size 13px
  margin-top 8px

.waitingHint
  font-size 11px
  color #f97316
  margin-top 4px

.status
  margin 10px 0
  font-size 13px
  color #6b7280
  text-align center
  &.error
    color #dc2626
  &.success
    color #16a34a
    font-weight 600
    font-size 15px

.progressContainer
  margin 16px 0

.progressBarBg
  width 100%
  height 6px
  background #e5e7eb
  border-radius 3px
  overflow hidden

.progressBarFill
  height 100%
  width 0%
  background #2563eb
  border-radius 3px
  transition width 0.3s ease

.progressText
  margin-top 6px
  font-size 12px
  color #2563eb
  font-weight 500
  text-align center

.speedText
  font-size 11px
  color #6b7280
  text-align center
  margin-top 2px

.fileProgress
  display flex
  justify-content space-between
  align-items center
  padding 8px 0
  border-bottom 1px solid #f3f4f6
  font-size 13px
  &:last-child
    border-bottom none

.fileProgressName
  color #374151
  font-weight 500
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  margin-right 8px

.fileProgressPct
  color #2563eb
  font-weight 600
  min-width 40px
  text-align right

.fileProgressDone
  color #16a34a

.btnBack
  display flex
  align-items center
  justify-content center
  margin 20px auto 0
  padding 0
  font-size 20px
  background #f3f4f6
  border 1px solid #d1d5db
  border-radius 50%
  cursor pointer
  color #374151
  width 48px
  height 48px
  line-height 1
  transition all 0.2s
  outline none
  &:hover
    background #e5e7eb
    transform scale(1.05)
