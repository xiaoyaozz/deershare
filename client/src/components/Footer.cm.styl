.base
  width 100%
  padding 16px 24px 24px
  text-align center

.btnCoffee
  padding 8px 18px
  font-size 12px
  background #fef3c7
  border 1px solid #fbbf24
  border-radius 16px
  cursor pointer
  color #92400e
  transition all 0.2s
  outline none
  &:active
    background #fde68a

.footerLinks
  display flex
  align-items center
  justify-content center
  gap 12px
  margin-top 10px

.footerDivider
  width 1px
  height 14px
  background #d1d5db
  border-radius 1px

.footerLink
  font-size 12px
  text-decoration none
  color #6b7280
  transition color 0.2s
  padding 4px 0
  &:hover
    color #2563eb

.copyright
  font-size 11px
  color #9ca3af
  margin-top 8px
